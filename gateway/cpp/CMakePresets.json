{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "dev",
            "displayName": "Development (debug info, tests, OAK camera)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "GATEWAY_WITH_DEPTHAI": "ON"
            }
        },
        {
            "name": "dev-mock",
            "displayName": "Development without depthai-core (mock camera only, fast)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "release-size",
            "displayName": "Release for the devices: smallest static binary, OAK camera",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel",
                "GATEWAY_SIZE": "ON",
                "GATEWAY_STATIC": "ON",
                "GATEWAY_WITH_DEPTHAI": "ON"
            }
        },
        {
            "name": "asan",
            "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "tsan",
            "displayName": "ThreadSanitizer",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=thread",
                "CMAKE_C_FLAGS": "-fsanitize=thread",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
            }
        }
    ],
    "buildPresets": [
        { "name": "dev", "configurePreset": "dev" },
        { "name": "dev-mock", "configurePreset": "dev-mock" },
        { "name": "release-size", "configurePreset": "release-size" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "tsan", "configurePreset": "tsan" }
    ],
    "testPresets": [
        { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
        { "name": "dev-mock", "configurePreset": "dev-mock", "output": { "outputOnFailure": true } },
        { "name": "release-size", "configurePreset": "release-size", "output": { "outputOnFailure": true } },
        { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
        { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } }
    ]
}
