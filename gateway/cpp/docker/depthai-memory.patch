+#ifdef DEPTHAI_RESOURCE_COMPILED_BINARIES
+// Unpack one file of an embedded tar.xz on demand into an exactly sized
+// buffer with `reserveExtra` bytes spare (so a header can be prepended
+// in place). Nothing is cached: the firmware is only needed while a
+// device boots, and keeping every file of the archive costs ~90 MB.
+static std::vector<std::uint8_t> unpackResource(const char* cmrcPath, const char* resourcePath, std::size_t reserveExtra = 0) {
+    auto fs = cmrc::depthai::get_filesystem();
+    auto tarXz = fs.open(cmrcPath);
+
+    struct archive* aPtr = archive_read_new();
+    DAI_CHECK_IN(aPtr);
+    dai::utility::ArchiveUtil archive(aPtr);
+    archive_read_support_filter_xz(archive.getA());
+    archive_read_support_format_tar(archive.getA());
+    if(archive_read_open_memory(archive.getA(), tarXz.begin(), tarXz.size()) != ARCHIVE_OK) {
+        throw std::runtime_error(fmt::format("Could not open embedded {}", cmrcPath));
+    }
+
+    struct archive_entry* entry;
+    while(archive_read_next_header(archive.getA(), &entry) == ARCHIVE_OK) {
+        if(std::string(resourcePath) != archive_entry_pathname(entry)) {
+            continue;
+        }
+        DAI_CHECK(archive_entry_size_is_set(entry) != 0, fmt::format("{} in {} has no size", resourcePath, cmrcPath));
+
+        std::vector<std::uint8_t> data;
+        data.reserve(static_cast<std::size_t>(archive_entry_size(entry)) + reserveExtra);
+        data.resize(static_cast<std::size_t>(archive_entry_size(entry)));
+
+        std::size_t offset = 0;
+        while(offset < data.size()) {
+            auto size = archive_read_data(archive.getA(), data.data() + offset, data.size() - offset);
+            DAI_CHECK(size > 0, fmt::format("Error reading {} from {}: {}", resourcePath, cmrcPath, size));
+            offset += static_cast<std::size_t>(size);
+        }
+        return data;
+    }
+    throw std::runtime_error(fmt::format("{} not found in embedded {}", resourcePath, cmrcPath));
+}
+#endif
+
+// Room for the preboot header in front of the firmware
+constexpr static std::size_t PREBOOT_HEADER_ROOM = 64 * 1024;
+
 static std::vector<std::uint8_t> createPrebootHeader(const std::vector<uint8_t>& payload, uint32_t magic1, uint32_t magic2);
 
