# Copy this file to gateway/.env and adjust it.
# Changes take effect after the gateway is restarted.

# strict = every request needs a Bearer token from the auth clients file
# development = no tokens, client chosen with the X-Dev-Client header.
#               Never use on an untrusted network.
GATEWAY_SECURITY_MODE=development

# Registered clients used in strict mode
GATEWAY_AUTH_CLIENTS_FILE=gateway/auth_clients.json

# How long a control lease lasts without being renewed
GATEWAY_CONTROL_LEASE_SECONDS=5

# Where the uploaded calibration JSON is stored
GATEWAY_CALIBRATION_FILE=gateway/calibration.json

# oak = real OAK camera
# mock = mock camera, no hardware is contacted
GATEWAY_CAMERA_PROVIDER=mock

GATEWAY_CAMERA_IP=169.254.1.223

GATEWAY_CAMERA_FPS=4

GATEWAY_CAMERA_RGB_WIDTH=1920
GATEWAY_CAMERA_RGB_HEIGHT=1080

# /camera/rgb and /camera/depth answer 503 rather than serve an older frame
GATEWAY_CAMERA_MAX_FRAME_AGE_SECONDS=5

# tcp = real robot over TCP
# mock = mock robot, no hardware is contacted
GATEWAY_ROBOT_PROVIDER=mock

# Robot controller address, for both the legacy socket server
# (GATEWAY_ROBOT_PORT) and Robot Web Services (GATEWAY_RWS_PORT).
# 127.0.0.1 = RobotStudio virtual controller on this PC
GATEWAY_ROBOT_HOST=192.168.125.1
GATEWAY_ROBOT_PORT=5001

# Robot Web Services on the controller (arm poses, RAPID control,
# /robot/rws moves)
GATEWAY_RWS_PORT=80
GATEWAY_RWS_USER=Default User
GATEWAY_RWS_PASSWORD=robotics

# RAPID task with the command variables used by /robot/rws/move and
# /robot/rws/home, and the longest a move may take (seconds)
GATEWAY_RWS_MOTION_TASK=T_ROB_L
GATEWAY_RWS_MOVE_TIMEOUT=60
