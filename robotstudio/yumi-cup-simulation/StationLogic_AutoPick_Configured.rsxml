<Station name="Project1" xmlns="urn:abb-robotics-robotstudio-graphiccomponent">
  <GraphicComponents>
    <EmbeddedLibrary source="%ABBLIBRARY%\Components\RapidVariable.rslib" name="ReadGripCommand">
      <PropertyValue name="DataType" value="bool" />
      <PropertyValue name="Task" value="" />
      <PropertyValue name="Module" value="" />
      <PropertyValue name="Variable" value="" />
      <PropertyValue name="Value" value="False" />
      <SignalValue name="Set" value="0" />
      <SignalValue name="Get" value="0" />
      <SignalValue name="Executed" value="0" />
    </EmbeddedLibrary>
    <EmbeddedLibrary source="%ABBLIBRARY%\Components\Timer.rslib" name="Timer">
      <PropertyValue name="StartTime" value="0" />
      <PropertyValue name="Interval" value="0.05" />
      <PropertyValue name="Repeat" value="True" />
      <PropertyValue name="CurrentTime" value="0" />
      <SignalValue name="Active" value="1" />
      <SignalValue name="Output" value="0" />
      <SignalValue name="Reset" value="0" />
    </EmbeddedLibrary>
    <SmartComponent name="SC_AutoPickPlace">
      <Properties>
        <DynamicProperty name="VC" valueType="ABB.Robotics.RobotStudio.Stations.VirtualController" value="../YuMi_Practice_VC">
          <Attribute key="AutoApply" value="true" />
        </DynamicProperty>
        <DynamicProperty name="Gripper" valueType="ABB.Robotics.RobotStudio.Stations.Mechanism" value="../Smart_Gripper_Servo_Fingers">
          <Attribute key="AutoApply" value="true" />
        </DynamicProperty>
        <DynamicProperty name="PickObject" valueType="ABB.Robotics.RobotStudio.Stations.IAttachableChild" value="../PickObject">
          <Attribute key="AutoApply" value="true" />
        </DynamicProperty>
        <DynamicProperty name="AttachmentFlange" valueType="System.Int32" value="0">
          <Attribute key="AutoApply" value="true" />
        </DynamicProperty>
      </Properties>
      <Bindings>
        <PropertyBinding source="VC" target="ReadClose.Controller" />
        <PropertyBinding source="VC" target="ReadOpen.Controller" />
        <PropertyBinding source="VC" target="WriteCloseDone.Controller" />
        <PropertyBinding source="VC" target="WriteOpenDone.Controller" />
        <PropertyBinding source="Gripper" target="CloseFingers.Mechanism" />
        <PropertyBinding source="Gripper" target="OpenFingers.Mechanism" />
        <PropertyBinding source="Gripper" target="AttachObject.Parent" />
        <PropertyBinding source="AttachmentFlange" target="AttachObject.Flange" />
        <PropertyBinding source="PickObject" target="AttachObject.Child" />
        <PropertyBinding source="PickObject" target="DetachObject.Child" />
        <PropertyBinding source="ReadClose.Value" target="CloseCommand.BooleanProperty" />
        <PropertyBinding source="ReadOpen.Value" target="OpenCommand.BooleanProperty" />
      </Bindings>
      <Connections>
        <IOConnection source="PollCommands.Output" target="ReadClose.Get" />
        <IOConnection source="PollCommands.Output" target="ReadOpen.Get" />
        <IOConnection source="CloseCommand.DigitalOutput" target="CloseEdge.Input" />
        <IOConnection source="OpenCommand.DigitalOutput" target="OpenEdge.Input" />
        <IOConnection source="CloseEdge.PulseHigh" target="CloseFingers.Execute" />
        <IOConnection source="OpenEdge.PulseHigh" target="OpenFingers.Execute" />
        <IOConnection source="CloseFingers.Executed" target="AttachObject.Execute" />
        <IOConnection source="OpenFingers.Executed" target="DetachObject.Execute" />
        <IOConnection source="AttachObject.Executed" target="WriteCloseDone.Set" />
        <IOConnection source="DetachObject.Executed" target="WriteOpenDone.Set" />
      </Connections>
      <GraphicComponents>
