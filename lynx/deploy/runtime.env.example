# Dry-run is the default: /start.sh does not include --live.
# Add --mock to /start.sh for a completely hardware-free startup.
# Mount a dedicated persistent SD directory at /state before running.
# Supply real network settings and credentials through deployment configuration.
GATEWAY_SECURITY_MODE=strict
GATEWAY_CONTROL_REQUIRE_SESSION=true
GATEWAY_AUTH_CLIENTS_FILE=/state/auth_clients.json
GATEWAY_CALIBRATION_FILE=/state/gateway-calibration.json
# Camera defaults are 960x540 at 2 FPS. Change them using launcher arguments:
# --camera-width 640 --camera-height 360 --camera-fps 2
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
MALLOC_ARENA_MAX=2
